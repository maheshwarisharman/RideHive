# -----------------------------------------------------------------------------
# RideHive Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# -----------------------------------------------------------------------------

# Supabase (Client-facing)
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Google Maps SDK (Mobile Client - restricted to Android/iOS bundle identifiers)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID="AIzaSyYourAndroidRestrictedKey"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS="AIzaSyYourIosRestrictedKey"

# Campus Defaults (BML Munjal University Main Gate)
EXPO_PUBLIC_CAMPUS_ORIGIN_LAT="28.24765"
EXPO_PUBLIC_CAMPUS_ORIGIN_LNG="76.81395"
EXPO_PUBLIC_CAMPUS_NAME="BML Munjal University Main Gate"

# Server Secrets (For Supabase Edge Functions - set via `supabase secrets set`)
# NEVER expose these in the client app bundle
GOOGLE_MAPS_SERVER_API_KEY="AIzaSyYourServerGoogleKeyWithPlacesAndRoutesEnabled"
EXPO_ACCESS_TOKEN="your-expo-access-token-if-push-receipts-needed"
